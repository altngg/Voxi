DB_NAME=voxi_db
DB_USER=voxi_user
DB_PASSWORD=voxi_password
DB_PORT=5432

SERVER_PORT=8080

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
LIQUIBASE_ENABLED=false

JWT_SECRET=ThisIsAVeryLongSecretKeyForJWTThatIsExactly64CharactersLongEnough2024
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173